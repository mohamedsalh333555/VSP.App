# ==============================================================================
# VSP Android Release Signing Configuration Template
# ==============================================================================
# Instructions for Production Release:
# 1. Generate a production release keystore using keytool:
#    keytool -genkey -v -keystore android/app/vsp-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias vsp-key
# 2. Copy this file to "android/key.properties" (do NOT commit key.properties to git).
# 3. Replace the placeholder credentials below with your actual keystore values:

storePassword=YOUR_PRODUCTION_STORE_PASSWORD
keyPassword=YOUR_PRODUCTION_KEY_PASSWORD
keyAlias=vsp-key
storeFile=vsp-release-key.jks
