 Row(
 children: [
 const Icon(Iconsax.chart_1_copy, color: VSPColors.accent, size: 18),
 const SizedBox(width: 8),
 Text(
 isAr ? 'تقدم إكتمال ملفك الرياضي' : 'Profile Completion',
 style: const TextStyle(
 color: Colors.white,
 fontSize: 13,
 fontWeight: FontWeight.bold,
 ),
 ),
