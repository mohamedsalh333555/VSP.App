class VSPAuthHeader extends StatelessWidget {
  final VoidCallback? onBack;
  final Widget? trailing;
  final bool showLogo;

  const VSPAuthHeader({
    super.key,
    this.onBack,
    this.trailing,
    this.showLogo = true,
