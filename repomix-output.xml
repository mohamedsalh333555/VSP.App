                : 'bg-red-500/15 text-red-400 border-red-500/30 hover:bg-red-500/25'
            }`}
          >
            {isOpen ? <Unlock className="w-4 h-4" /> : <Lock className="w-4 h-4" />}
            <span>{isOpen ? 'بوابة التسجيل: مفتوحة' : 'بوابة التسجيل: مغلقة'}</span>
          </button>

