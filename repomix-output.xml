import 'package:cloud_firestore/cloud_firestore.dart';

/// Stadium data model
class Stadium {
  final String id;
  final String name;
  final String location;
  final String imageUrl;
  final List<String> images;
  final String type; // Football, Basketball, etc.
  final String size; // 11 VS 11, 5 VS 5, etc.
