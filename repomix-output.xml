                borderRadius: BorderRadius.circular(VSPRadius.sm),
              ),
              child: FittedBox(
                fit: BoxFit.scaleDown,
                child: Text(
                  'SKL ${player.skillPoints} | GL ${player.goals} | TCK ${player.tackles}',
                  style: const TextStyle(
                    color: Colors.black,
                    fontSize: 7,
                    fontWeight: FontWeight.bold,
