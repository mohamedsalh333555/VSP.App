                  Row(
                    children: [
                      // Tab 0: تجميع
                      Expanded(
                        child: GestureDetector(
                          onTap: () {
                            HapticFeedback.selectionClick();
                            setState(() => _selectedMainTab = 0);
                          },
                          behavior: HitTestBehavior.opaque,
                          child: Center(
                            child: Builder(
                              builder: (context) {
                                final isArabic = Localizations.localeOf(context).languageCode == 'ar';
