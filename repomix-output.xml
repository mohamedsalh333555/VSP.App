  FakeGoRouterState(String url) : _uri = Uri.parse(url);

  @override
  Uri get uri => _uri;

  @override
  String get matchedLocation => _uri.path;

  @override
  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
