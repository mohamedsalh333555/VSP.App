      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: SingleChildScrollView(
              child: CopilotChatBubble(
                message: msg,
                isArabic: true,
                onSelectTournament: (t) => selectedTourney = t,
                onJoinMatch: (m) => joinedMatch = m,
