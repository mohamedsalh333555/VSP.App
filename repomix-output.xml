      matchCoord.checkMatchScheduleConflict(
        championshipId: championshipId,
        matchId: matchId,
        homeTeamId: homeTeamId,
        awayTeamId: awayTeamId,
        scheduledTime: scheduledTime,
        matchDurationMinutes: matchDurationMinutes,
