                child: const Text('Test Navigation'),
              ),
            ),
          ),
        ),
      );

      await tester.tap(find.text('Test Navigation'));
      await tester.pumpAndSettle();

      expect(find.text('Test Navigation'), findsOneWidget);
    });
  });
