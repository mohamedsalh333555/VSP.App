      showToast(t('error_loading') || 'حدث خطأ في جلب البيانات', 'error');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetch1v1Data();
  }, []);

  // Toggle Gate
  const toggleGate = async () => {
    setProcessing(true);
