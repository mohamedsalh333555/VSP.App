import urllib.error
import json

with open("env.json", "r") as f:
    env = json.load(f)

token = env["SUPABASE_MANAGEMENT_KEY"]
url = "https://api.supabase.com/v1/projects/mktqkddbcddrxjxabdua/database/query"

def run_query(sql):
    payload = json.dumps({"query": sql}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}",
            "User-Agent": "Mozilla/5.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req) as resp:
            return True, json.loads(resp.read())
    except urllib.error.HTTPError as e:
        err_content = e.read().decode('utf-8')
        try:
            err_json = json.loads(err_content)
            return False, err_json.get('message', err_content)
        except Exception:
            return False, err_content

print("=" * 80)
print("🛡️ RUNNING COMPREHENSIVE LIVE PENETRATION TEST SUITE (14 ATTACK SCENARIOS)")
print("=" * 80)

tests_passed = 0
total_tests = 0

def test_attack(test_num, name, test_sql, evaluate_fn):
    global tests_passed, total_tests
    total_tests += 1
    print(f"\n[{test_num}/14] 🎯 ATTACK: {name}")
    success, data_or_err = run_query(test_sql)
    passed, detail = evaluate_fn(success, data_or_err)
    if passed:
        tests_passed += 1
        print(f"      ✅ ATTACK BLOCKED / SAFE: {detail}")
    else:
        print(f"      🚨 VULNERABILITY DETECTED / FAILED: {detail}")

# 1. Attack 1: Direct Role Mutation on Users Table (Trigger protect_user_sensitive_fields)
test_attack(
    1,
    "Direct SQL Mutation on user role (protect_user_sensitive_fields)",
    """
    DO $$
    BEGIN
        -- Set session to simulate a real regular player user
        PERFORM set_config('request.jwt.claims', '{"sub": "46967c5c-f8cd-4a22-a4b6-44556c44360b", "role": "authenticated"}', true);
        UPDATE public.users SET role = 'admin' WHERE id = '46967c5c-f8cd-4a22-a4b6-44556c44360b';
    END $$;
    """,
    lambda success, res: (not success and ("PERMISSION_DENIED" in str(res) or "Security Alert" in str(res) or "42501" in str(res)), f"Blocked by trigger with exception: {res}")
)

# 2. Attack 2: IDOR Profile Overwrite (complete_user_registration)
test_attack(
    2,
    "IDOR in Profile Registration targeting victim UUID (complete_user_registration)",
    """
    DO $$
    BEGIN
        PERFORM set_config('request.jwt.claims', '{"sub": "b3fffb87-5709-49a4-9f05-e22111144f1e", "role": "authenticated"}', true);
    END $$;
    SELECT public.complete_user_registration(
        '22222222-2222-2222-2222-222222222222'::uuid,
        '01099999999',
        'Hacked Profile'
    );
    """,
    lambda success, res: (success and res[0]['complete_user_registration'].get('success') == False, f"Rejection message: '{res[0]['complete_user_registration'].get('error')}'")
)

# 3. Attack 3: IDOR Role Change (set_user_role_on_signup)
test_attack(
    3,
    "IDOR Role Change targeting victim UUID (set_user_role_on_signup)",
    """
    DO $$
    BEGIN
        PERFORM set_config('request.jwt.claims', '{"sub": "b3fffb87-5709-49a4-9f05-e22111144f1e", "role": "authenticated"}', true);
        PERFORM public.set_user_role_on_signup('player', '22222222-2222-2222-2222-222222222222'::uuid);
    END $$;
    """,
    lambda success, res: (not success and "Unauthorized" in str(res), f"Blocked with DB error: '{res}'")
)

# 4. Attack 4: Self-Promote to Admin via set_user_role_on_signup
test_attack(
    4,
    "Self-Promote to Admin via set_user_role_on_signup",
    """
