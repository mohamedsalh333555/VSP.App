class _UnifiedSuccessDialog extends StatefulWidget {
  final bool isOwner;
  const _UnifiedSuccessDialog({this.isOwner = false});

  @override
  State<_UnifiedSuccessDialog> createState() => _UnifiedSuccessDialogState();
}

