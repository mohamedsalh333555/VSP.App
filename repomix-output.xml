-- ول للمستخدمين الآخرين برؤية الحسابات غير المحظورة (لعرض الفرق والبحث)
CREATE POLICY "users_select_authenticated" ON public.users
FOR SELECT
TO authenticated
USING (
  (auth.uid() = id) OR 
  (EXISTS (
    SELECT 1 FROM public.users u 
    WHERE u.id = auth.uid() 
      AND u.role IN ('admin', 'co_founder')
  )) OR
