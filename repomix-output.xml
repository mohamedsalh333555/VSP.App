      lat: 30.05,
      lng: 31.35,
      needsDeposit: false,
      depositAmount: 0.0,
      hasJerash: true,
      hasBall: true,
      hasSeats: true,
      features: {
        'bathOption': 'Yes',
        'garage': true,
      },
    );

    final stadiumB = Stadium(
      id: 's2',
      name: 'Sunset Arena',
      location: 'Maadi',
      governorate: 'Cairo',
      imageUrl: '',
      type: 'Padel',
      size: '2 VS 2',
