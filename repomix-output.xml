            onPressed: () => Navigator.pop(ctx, ManualBookingCancelDecision.abort),
            child: Text(
              isArabic ? 'تراجع وعدم الإلغاء' : 'Keep Booking',
              style: const TextStyle(color: VSPColors.textSecondary),
            ),
          ),
        ],
      ),
    );
    return result ?? ManualBookingCancelDecision.abort;
  }
