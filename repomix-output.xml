 // Filter stadiums by governorate
 void applyGovernorateFilter(String? governorate) {
 if (_selectedGovernorate == governorate) return;
 
 _selectedGovernorate = governorate;
 _stadiums = [];
 _filteredStadiums = [];
 _lastDocument = null;
 _hasMore = true;
