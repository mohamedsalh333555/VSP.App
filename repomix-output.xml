LANGUAGE plpgsql
IMMUTABLE
AS $function$
BEGIN
    IF p_gov IS NULL OR trim(p_gov) = '' THEN
        RETURN 'Cairo';
    END IF;
    
    RETURN CASE trim(lower(p_gov))
