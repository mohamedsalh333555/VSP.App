                Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: List.generate(player.titles, (i) => const Padding(
                    padding: EdgeInsets.symmetric(horizontal: 1),
                    child: Icon(Icons.emoji_events, color: Colors.black, size: 14),
                  )),
                )
            ]
          ]
        ],
      ),
    );
  }
}

