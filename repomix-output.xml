      const loaded = StadiumLoadedData(
        name: 'Anfield',
        location: 'Liverpool',
        price: '300',
        capacity: '16',
        deposit: '50',
        requireDeposit: true,
        phone: '01122334455',
        floorType: 'Natural',
        sportType: 'Football',
        bathOption: 'Yes',
        cafeteria: true,
        garage: false,
        changingRoom: true,
        seats: '30',
        length: '70',
        width: '50',
        hasBall: true,
        ballPrice: '40',
        startTime: TimeOfDay(hour: 16, minute: 0),
        endTime: TimeOfDay(hour: 23, minute: 0),
        isSplitShift: false,
        breakTimes: [],
        images: [],
        notes: 'Red turf',
      );

      controllers.populateFromLoaded(loaded);

