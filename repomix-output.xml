      width: 90px;
      height: 90px;
      margin: 0 auto 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 42px;
      position: relative;
    }

    .icon-success {
      background: rgba(159, 223, 2, 0.15);
      color: var(--primary);
      border: 2px solid var(--primary);
      box-shadow: 0 0 30px var(--primary-glow);
    }

