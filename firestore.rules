rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAppOwner() {
      return isAuthenticated() && getUserData().role == 'owner';
    }
    
    
    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Stadiums Collection
    match /stadiums/{stadiumId} {
      allow read: if true; // Discovery is public
      allow create: if isAppOwner();
      allow update, delete: if isAppOwner() && resource.data.ownerId == request.auth.uid;
    }

    // BOOKINGS: Allow read for availability checks, but restrict write
    match /bookings/{bookingId} {
      
      // âœ… FIX: Allow any authenticated user to READ bookings
      // (Necessary for: 1. Double-booking prevention Transaction,
      //  2. Showing booked/greyed-out slots in the calendar UI)
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated();
      
      // Only booking creator or stadium owner can update (cancel, change status, submit result)
      allow update: if isAuthenticated() && (
        resource.data.createdByUserId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid
      );
      
      allow delete: if false; // Soft delete or status change only
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.createdByUserId == request.auth.uid || 
        teamId == request.auth.uid // If teamId is userId
      );
    }
    
    // Chat or other collections...
  }
}

