rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      // 🚨 الحماية القاتلة: منع المستخدم من تعديل رتبته، ديونه، أو رصيده
      allow update: if isAuthenticated() && isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'commissionDebt', 'walletBalance', 'isSuspended', 'isBlocked', 'points']);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    match /stadiums/{stadiumId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // منع المالك من توثيق ملعبه بنفسه
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified']);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.createdByUserId == request.auth.uid;
    }
  }
}
